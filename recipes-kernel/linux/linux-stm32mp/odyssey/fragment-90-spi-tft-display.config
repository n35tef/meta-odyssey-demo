# Odyssey 40-pin header: Waveshare 3.5" ILI9486 SPI TFT + XPT2046 touch. ST's cleanup
# fragment disables CONFIG_STAGING and CONFIG_FRAMEBUFFER_CONSOLE; re-enable what fbtft
# and fbcon need (FB, backlight class, touchscreen and SPI are already =y).

CONFIG_STAGING=y

# fbtft + ILI9486 panel driver (drivers/staging/fbtft)
CONFIG_FB_TFT=m
CONFIG_FB_TFT_ILI9486=m

# XPT2046 / ADS7846 resistive touch on SPI
CONFIG_TOUCHSCREEN_ADS7846=m

# STM32 SPI controller built-in so SPI5 is up early (base config has it =m)
CONFIG_SPI_STM32=y
CONFIG_SPI_SPIDEV=y

# Linux console on the small panel; harmless if unused
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
